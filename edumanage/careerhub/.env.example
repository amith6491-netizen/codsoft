# PostgreSQL connection string
DATABASE_URL="postgresql://careerhub:careerhub@localhost:5432/careerhub?schema=public"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# File storage
# local | s3  (local writes to /public/uploads/resumes, s3 needs the vars below)
STORAGE_DRIVER="local"
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
